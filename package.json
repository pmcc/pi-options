{
	"name": "pi-options",
	"version": "0.1.0",
	"description": "pi extension that adds the present_options tool for interactive choice selection",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"repository": {
		"type": "git",
		"url": "git+https://gitea.itspm.cc/pmcc/pi-options.git"
	},
	"homepage": "https://gitea.itspm.cc/pmcc/pi-options",
	"bugs": {
		"url": "https://gitea.itspm.cc/pmcc/pi-options/issues"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run lint && npm run typecheck && npm test",
		"pack:check": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "^24.0.0",
		"typebox": "1.3.7",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
